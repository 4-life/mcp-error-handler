PORT=3010
APP_CONFIG_DIR=./config/apps
REPO_CACHE_DIR=./data/repos
WORKTREE_DIR=./data/worktrees

# Caps concurrent draftFix (AI agent) runs across all in-flight requests — protects against a
# burst of distinct errors spawning unbounded, expensive AI sessions at once. Defaults to 3.
# MAX_CONCURRENT_DRAFTS=3

# Spend caps for ai_provider: claude. Per-session ($2 default) stops a single stuck/looping run;
# cumulative ($50 default) is the total across every session since this process started — resets
# on restart, so it's a safety net, not a precise billing control. Raise both deliberately.
# MAX_USD_PER_DRAFT=2
# MAX_TOTAL_USD=50

# Required — every request to /mcp and /webhooks/* needs `Authorization: Bearer <this>`.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_SHARED_SECRET=

# Required for the default ai_provider: claude (providers/llm/claude.ts, via the Claude Agent SDK).
# ANTHROPIC_API_KEY=

# Wired up as each remaining stub gets implemented:
# OPENAI_API_KEY=       (ai_provider: codex — not implemented yet)
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
# SLACK_BOT_TOKEN=
# CONFLUENCE_BASE_URL=
# CONFLUENCE_API_TOKEN=